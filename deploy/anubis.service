# /etc/systemd/system/anubis.service
[Unit]
Description=Anubis - orquestrador da stack de mídia do FeuVault
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=rafeu
Group=rafeu
ExecStart=/usr/local/bin/anubis --config /home/rafeu/.config/anubis/anubis.toml serve
Restart=always
RestartSec=5

# limites de recursos (cgroups): ~13 MB ocioso; baixando a 11 MiB/s, ~20 MB
# e ~4% de CPU. A folga cobre vários players abertos e a verificação de peças.
MemoryMax=256M
CPUQuota=50%

# confinamento: o disco é somente leitura (as exclusões passam pelas APIs do
# Sonarr/Radarr/qBittorrent), menos a pasta onde o "assistir agora" baixa
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/raid0/anubis/blackhole
# estado do "assistir agora" (sessão do librqbit, pedidos): /var/lib/anubis
StateDirectory=anubis
PrivateTmp=true
# dispositivos: só a GPU, para converter vídeo com VAAPI
DevicePolicy=closed
DeviceAllow=/dev/dri/renderD128 rw
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
